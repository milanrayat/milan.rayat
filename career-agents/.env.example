# Local development only. In GitHub Actions these are repository secrets;
# on the Mac they are read from the Keychain at runtime.
SHEET_ID=
ANTHROPIC_API_KEY=
# Path to the service-account key file (never commit it)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Or the JSON itself (GitHub Actions secret GOOGLE_SERVICE_ACCOUNT_JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=
